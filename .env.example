# Copy to .env.local and fill in. .env.local is gitignored - never commit real values.

# --- Firebase client (safe to ship to the browser) -------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=fignalplatinum.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=fignalplatinum
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=fignalplatinum.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server only - NEVER prefix these with NEXT_PUBLIC_) -----
# From Firebase console > Project settings > Service accounts > Generate key.
# The private key must keep its literal \n newlines.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Outbound email (server only) -------------------------------------------
# SMTP 465 is implicit TLS. IMAP/POP3 are inbound-only and not used.
MAIL_HOST=mail.farisium.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Fignal Platinum <no-reply@farisium.com>"
# Where account/notification emails are sent to the desk owner.
MAIL_ADMIN_INBOX=

# --- Admin master account ---------------------------------------------------
# Seeded once by scripts/seed-admin.mjs, which sets the admin custom claim.
# The password is only used by that script and is never read at runtime.
ADMIN_SEED_EMAIL=
ADMIN_SEED_USERNAME=
ADMIN_SEED_PASSWORD=

# --- Translation (server only) ----------------------------------------------
# Groq OpenAI-compatible gateway. Used at publish time to translate the
# analyst's English reason; the original is always stored alongside.
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- QRIS payments (server only) -------------------------------------------
# 'production' or 'sandbox'. Sandbox base is https://klikqris.com/api/sandbox
KLIKQRIS_MODE=sandbox
KLIKQRIS_API_BASE=https://klikqris.com/api
KLIKQRIS_API_KEY=
KLIKQRIS_ID_MERCHANT=

# --- Admin PIN (server only) -----------------------------------------------
# A convenience door for /admin, verified server-side only - the PIN is never
# shipped to the browser. Both must be set on the host or the PIN path fails.
# The desk account + admin custom claim stays the real control.
ADMIN_PIN=
# Long random string that signs the PIN session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
SESSION_SECRET=

# --- Public URL of this deployment (used in payment callbacks + email links) --
NEXT_PUBLIC_SITE_URL=http://localhost:3000